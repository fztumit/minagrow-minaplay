{
  "name": "minaplay",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "sync:release": "node scripts/sync-release.mjs",
    "build:server": "tsc -p tsconfig.json",
    "prebuild:client": "npm run sync:release",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:server && npm run build:client",
    "dev": "npm run build:client && tsx server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "start:tablet": "HOST=0.0.0.0 PORT=3100 node dist/server.js",
    "app:sync": "npm run build:client && npx cap sync android",
    "android:open": "npm run app:sync && npx cap open android",
    "android:debug": "npm run app:sync && node scripts/android-debug.mjs",
    "lint": "eslint \"server.ts\" \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test tests/playwright",
    "tts:ceee": "node scripts/generate-pofi-ceee-tts.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.22.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
